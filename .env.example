# Local and hosted runtime values must use the same keys.
# Keep real values in an ignored environment file or deployment secret manager.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_ALLOWLIST=deepseek/deepseek-v4-flash
OPENROUTER_CONCURRENCY=4
OPENROUTER_ANNOTATION_MAX_TOKENS=8000
OPENROUTER_MAX_TOKENS=4000
OPENROUTER_TIMEOUT_MS=90000
# Keep disabled until an authenticated caller and provider budget are configured.
CSKL_ATLAS_EXPLAIN_ENABLED=false
CSKL_ATLAS_EXPLAIN_ACCESS_TOKEN=
CSKL_ATLAS_EXPLAIN_TRUST_SAME_ORIGIN=false
CSKL_ATLAS_PUBLIC_ORIGIN=http://localhost:3000

# Python API / operations. Generate a long random value before enabling writes.
CSKL_ATLAS_CATALOG=var/catalog/atlas.sqlite
CSKL_ATLAS_OPS_TOKEN=
CSKL_ATLAS_ALLOWED_ORIGINS=http://localhost:3000
NCBI_EMAIL=
NCBI_API_KEY=
NCBI_SOFT_CONCURRENCY=4
CSKL_ATLAS_PROBES=resources/releases/gpl570/probes.txt
CSKL_ATLAS_PROBE_ANNOTATION=resources/releases/gpl570/probe-annotation.tsv
CSKL_ATLAS_REACTOME_INDEX=var/reactome/reactome-gpl570.sqlite
CSKL_ATLAS_EXPLANATION_CACHE=var/explanations

# Optional server-side web connection to a published Atlas API snapshot.
CSKL_ATLAS_API_URL=
CSKL_ATLAS_STRATUM=GPL570:global
